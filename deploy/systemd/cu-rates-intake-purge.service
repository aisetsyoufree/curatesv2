[Unit]
Description=CU-Rates.org Correction Inbox Contact Retention (deletes reply contacts 90 days after resolution)
Documentation=file:///var/lib/cu-rates/app/deploy/README.md https://github.com/aisetsyoufree/curatesv2

[Service]
Type=oneshot
User=cu-rates
Group=cu-rates
WorkingDirectory=/var/lib/cu-rates/app

ExecStart=/var/lib/cu-rates/venv/bin/python -m cu_rates.intake --db /var/lib/cu-rates/intake/intake.sqlite purge-contacts
Restart=no

LogsDirectory=cu-rates
UMask=0077

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Filesystem Access: only the intake directory is writable (the inbox database and its rollback
# journal); the application code is read-only.
ReadWritePaths=/var/lib/cu-rates/intake
ReadOnlyPaths=/var/lib/cu-rates/app

# Resource Limits (Raspberry Pi 5 with 16 GB RAM)
MemoryMax=256M
TasksMax=64
CPUQuota=100%
