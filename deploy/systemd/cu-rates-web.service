[Unit]
Description=CU-Rates.org Web Application
Documentation=file:///var/lib/cu-rates/app/deploy/README.md https://github.com/aisetsyoufree/curatesv2
After=network.target

[Service]
Type=exec
User=cu-rates
Group=cu-rates
WorkingDirectory=/var/lib/cu-rates/app
EnvironmentFile=-/etc/cu-rates/cu-rates.env

ExecStart=/var/lib/cu-rates/venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 3 --threads 2 --worker-class gthread --access-logfile - --error-logfile - "cu_rates.web.app:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5s

RuntimeDirectory=cu-rates-web
RuntimeDirectoryMode=0755

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Filesystem Access: Web process reads published snapshots and app code only.
# It NEVER opens or references the worker database (/var/lib/cu-rates/data).
ReadOnlyPaths=/var/lib/cu-rates/app /var/lib/cu-rates/snapshots
ReadWritePaths=/run/cu-rates-web /tmp

# Resource Limits (Raspberry Pi 5 with 16 GB RAM)
MemoryMax=512M
TasksMax=64
CPUQuota=100%

[Install]
WantedBy=multi-user.target
