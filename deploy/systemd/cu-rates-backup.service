[Unit]
Description=CU-Rates.org Database and Artifact Store Backup
Documentation=file:///var/lib/cu-rates/app/deploy/README.md https://github.com/aisetsyoufree/curatesv2

[Service]
Type=oneshot
User=cu-rates
Group=cu-rates
WorkingDirectory=/var/lib/cu-rates/app

ExecStart=/var/lib/cu-rates/venv/bin/python -m cu_rates.ops.backup create --database /var/lib/cu-rates/data/operational.sqlite --artifact-root /var/lib/cu-rates/artifacts --destination /var/lib/cu-rates/backups --denylist-path /var/lib/cu-rates/independent/denylist.json --automatic-denylist-path /var/lib/cu-rates/automatic/denylist.json --intake-database /var/lib/cu-rates/intake/intake.sqlite --snapshot-root /var/lib/cu-rates/snapshots
ExecStart=/var/lib/cu-rates/venv/bin/python -m cu_rates.ops.backup prune --destination /var/lib/cu-rates/backups --keep 14
Restart=no

LogsDirectory=cu-rates
UMask=0077

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Filesystem Access: the backup is written ONLY to /var/lib/cu-rates/backups. The artifact
# store, ledgers, snapshots and application code are read-only. The two SQLite directories
# must be writable because both databases can use WAL mode: even a read-only open
# (mode=ro) needs to create the -shm file next to it, and fails with "attempt to write
# a readonly database" otherwise
# (pinned by tests/test_ops_wal_readonly.py). The tool never writes either database.
ReadWritePaths=/var/lib/cu-rates/backups /var/lib/cu-rates/data /var/lib/cu-rates/intake
ReadOnlyPaths=/var/lib/cu-rates/app /var/lib/cu-rates/artifacts /var/lib/cu-rates/independent /var/lib/cu-rates/automatic /var/lib/cu-rates/snapshots

# Resource Limits (Raspberry Pi 5 with 16 GB RAM)
MemoryMax=1G
TasksMax=64
CPUQuota=100%
