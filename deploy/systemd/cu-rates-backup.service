[Unit]
Description=CU-Rates.org Database and Artifact Store Backup
Documentation=file:///var/lib/cu-rates/app/deploy/README.md https://github.com/aisetsyoufree/curatesv2

[Service]
Type=oneshot
User=cu-rates
Group=cu-rates
WorkingDirectory=/var/lib/cu-rates/app

ExecStart=/var/lib/cu-rates/venv/bin/python -m cu_rates.ops.backup create --database /var/lib/cu-rates/data/operational.sqlite --artifact-root /var/lib/cu-rates/artifacts --destination /var/lib/cu-rates/backups
ExecStart=/var/lib/cu-rates/venv/bin/python -m cu_rates.ops.backup prune --destination /var/lib/cu-rates/backups --keep 14
Restart=no

LogsDirectory=cu-rates
UMask=0077

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Filesystem Access: the backup is written ONLY to /var/lib/cu-rates/backups. The artifact
# store and the application code are read-only. The data directory must be writable because
# the operational database is in WAL mode: even a read-only open (mode=ro) needs to create the
# -shm file next to it, and fails with "attempt to write a readonly database" otherwise
# (pinned by tests/test_ops_wal_readonly.py). The tool still never writes the database.
ReadWritePaths=/var/lib/cu-rates/backups /var/lib/cu-rates/data
ReadOnlyPaths=/var/lib/cu-rates/app /var/lib/cu-rates/artifacts

# Resource Limits (Raspberry Pi 5 with 16 GB RAM)
MemoryMax=1G
TasksMax=64
CPUQuota=100%
