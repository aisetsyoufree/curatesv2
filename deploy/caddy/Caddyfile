# CU-Rates.org V2 — Caddy Reverse Proxy Configuration (Site Fragment)
# Behind Cloudflare Tunnel with no inbound router port (MASTER.md D-09).
# Cloudflared terminates edge TLS and routes plain HTTP to loopback port 8080.
# No secrets are stored in this file.
# Note: This is a site-only fragment (no global options block) to prevent
# conflicts with the host's existing global options in /etc/caddy/Caddyfile.

# Canonical domain configuration
http://cu-rates.org:8080 {
    # Listen only on loopback interface behind Cloudflare Tunnel (no external router port)
    bind 127.0.0.1

    # Reverse proxy to Gunicorn WSGI server on 127.0.0.1:8000
    reverse_proxy 127.0.0.1:8000 {
        header_up Host {host}
        # CF-Connecting-IP provided by Cloudflare is forwarded as an opaque header only.
        # The application must NOT trust CF-Connecting-IP or forwarded headers for security decisions.
        header_up CF-Connecting-IP {header.CF-Connecting-IP}
        header_up X-Forwarded-Proto https
    }

    # Response headers: do NOT duplicate application security headers here
    # (browser security headers are managed in src/cu_rates/web/app.py to prevent drift).
    header {
        -Server
    }

    # Access and error logging:
    # Discard access logging at Caddy layer (structured query-free logging is handled upstream by Gunicorn).
    # Configure log filter so request URIs (including query strings) and headers are redacted/deleted,
    # ensuring upstream proxy failures or error logs never record sensitive query strings or headers.
    log {
        output discard
        format filter {
            wrap console
            fields {
                request>uri delete
                request>headers delete
            }
        }
    }
}

# Redirect www to apex canonical origin (MASTER.md §8: https://cu-rates.org)
http://www.cu-rates.org:8080 {
    bind 127.0.0.1
    redir https://cu-rates.org{uri} permanent
}
