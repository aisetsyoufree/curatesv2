# CU-Rates.org V2 — Deployment Environment Configuration Template
# File location: /etc/cu-rates/cu-rates.env
# Permissions: Must be mode 0600 (read/write only by owner/unprivileged user)
# Setup command:
#   sudo install -m 0600 -o cu-rates -g cu-rates deploy/env.example /etc/cu-rates/cu-rates.env
#
# WEB CONFIGURATION (T055):
# create_app() reads the six named web variables below from the process environment.
# create_app(config_dict) uses only that dictionary and safe defaults (no environment).
# Invalid values abort startup. Unset settings use safe defaults. Empty GA id = absent;
# empty origins/paths/booleans are invalid. Booleans accept only 0 or 1.
#
# SECURITY GUIDANCE:
# - This template contains PLACEHOLDERS ONLY. Never commit actual secret tokens or keys.
# - Keep permissions at 0600 (chmod 0600 /etc/cu-rates/cu-rates.env).
# - If runtime secrets are introduced, provide them via systemd LoadCredential= or
#   an 0600 EnvironmentFile accessible only by the cu-rates service user.

# -----------------------------------------------------------------------------
# Gunicorn WSGI Server Settings
# -----------------------------------------------------------------------------
# Extra runtime CLI arguments passed directly to Gunicorn.
# read by: gunicorn only
GUNICORN_CMD_ARGS="--workers 3 --threads 2"

# -----------------------------------------------------------------------------
# Application Configuration (T055)
# -----------------------------------------------------------------------------
# Canonical origin: bare HTTPS DNS origin, optional valid port, no query/fragment/path.
# read by: create_app()
CANONICAL_ORIGIN=https://cu-rates.org

# Analytics default disabled (D-08). ID must be G- plus exactly 10 uppercase letters/digits.
# read by: create_app()
ENABLE_ANALYTICS=0
# read by: create_app()
GA_MEASUREMENT_ID=

# Public snapshots and independent ledger: absolute paths without whitespace or parent traversal.
# Unset paths use local data/snapshots and data/independent/withdrawals.json.
# Missing/invalid snapshots or denylists fail closed.
# read by: create_app()
SNAPSHOT_ROOT=/var/lib/cu-rates/snapshots
# read by: create_app()
DENYLIST_PATH=/var/lib/cu-rates/independent/denylist.json

# Correction inbox (issue #100). Leave UNSET (the form shows "not open yet") until a person has
# been assigned to check the inbox within one business day with
#   sudo -u cu-rates /var/lib/cu-rates/venv/bin/python -m cu_rates.intake --db <path> list
# After running `... init` once, set the absolute path below. The directory must be owned by the
# service user and mode 0700; the web process can only add cases to it.
# read by: create_app()
# INTAKE_DB=/var/lib/cu-rates/intake/intake.sqlite

# Ad readiness only: reserved footer space; no ads or third-party code is shipped.
# Keep disabled at launch. Requires a later approved decision to serve real ads.
# read by: create_app()
ADS_ENABLED=0

# No environment variable enables live collection; D-15 remains enforced in code.
