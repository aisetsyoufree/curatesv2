# CU-Rates.org V2 — Deployment Environment Configuration Template
# File location: /etc/cu-rates/cu-rates.env
# Permissions: Must be mode 0600 (read/write only by owner/unprivileged user)
# Setup command:
#   sudo install -m 0600 -o cu-rates -g cu-rates deploy/env.example /etc/cu-rates/cu-rates.env
#
# SECURITY GUIDANCE:
# - This template contains PLACEHOLDERS ONLY. Never commit actual secret tokens or keys.
# - Keep permissions at 0600 (chmod 0600 /etc/cu-rates/cu-rates.env).
# - If runtime secrets are introduced, provide them via systemd LoadCredential= or
#   an 0600 EnvironmentFile accessible only by the cu-rates service user.

# -----------------------------------------------------------------------------
# Web Service Configuration
# -----------------------------------------------------------------------------
# Canonical origin for the public website (MASTER.md §8)
CANONICAL_ORIGIN=https://cu-rates.org

# Bind host and port for Gunicorn (loopback only behind reverse proxy)
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_WORKERS=3
WEB_THREADS=2

# Analytics (default disabled per MASTER.md §8, D-08)
ENABLE_ANALYTICS=0
GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Filesystem Paths (Under single NVMe root, never SD card or cloud-synced path)
# -----------------------------------------------------------------------------
CU_RATES_ROOT=/var/lib/cu-rates
CU_RATES_APP_DIR=/var/lib/cu-rates/app
CU_RATES_VENV_DIR=/var/lib/cu-rates/venv

# Public Snapshot Storage (Read-only for web service)
CU_RATES_SNAPSHOT_DIR=/var/lib/cu-rates/snapshots
CU_RATES_DENYLIST_PATH=/var/lib/cu-rates/snapshots/denylist.json

# Backup Staging Path (Encrypted off-device backup per MASTER.md §5, §7)
CU_RATES_BACKUP_DIR=/var/lib/cu-rates/backups

# Worker Operational Storage (Worker only; never opened by web process per MASTER.md §6)
CU_RATES_DATA_DIR=/var/lib/cu-rates/data
CU_RATES_ARTIFACTS_DIR=/var/lib/cu-rates/artifacts

# -----------------------------------------------------------------------------
# Worker Control Flags (MASTER.md Decision D-15)
# -----------------------------------------------------------------------------
# Live collection is NOT approved and must remain disabled (0).
CU_RATES_LIVE_COLLECTION_ENABLED=0
CU_RATES_SCHEDULER_ENABLED=0
CU_RATES_MOCK_TRANSPORT_ONLY=1
