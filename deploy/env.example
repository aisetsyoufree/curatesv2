# CU-Rates.org V2 — Deployment Environment Configuration Template
# File location: /etc/cu-rates/cu-rates.env
# Permissions: Must be mode 0600 (read/write only by owner/unprivileged user)
# Setup command:
#   sudo install -m 0600 -o cu-rates -g cu-rates deploy/env.example /etc/cu-rates/cu-rates.env
#
# IMPORTANT NOTICE:
# The Flask application in src/cu_rates/web/ does NOT read environment variables
# today (create_app takes a config dict). Therefore, application variables listed
# below currently have NO EFFECT until environment-to-config wiring is implemented
# in task T055.
#
# SECURITY GUIDANCE:
# - This template contains PLACEHOLDERS ONLY. Never commit actual secret tokens or keys.
# - Keep permissions at 0600 (chmod 0600 /etc/cu-rates/cu-rates.env).
# - If runtime secrets are introduced, provide them via systemd LoadCredential= or
#   an 0600 EnvironmentFile accessible only by the cu-rates service user.

# -----------------------------------------------------------------------------
# Gunicorn WSGI Server Settings
# -----------------------------------------------------------------------------
# Extra runtime CLI arguments passed directly to Gunicorn.
# read by: gunicorn only
GUNICORN_CMD_ARGS="--workers 3 --threads 2"

# -----------------------------------------------------------------------------
# Application Configuration (T055)
# -----------------------------------------------------------------------------
# Canonical origin for the public website (MASTER.md §8)
# not yet read by the app (T055)
CANONICAL_ORIGIN=https://cu-rates.org

# Analytics configuration (default disabled per MASTER.md §8, D-08)
# not yet read by the app (T055)
ENABLE_ANALYTICS=0
# not yet read by the app (T055)
GA_MEASUREMENT_ID=

# Public Snapshot Storage (MASTER.md §6)
# not yet read by the app (T055)
CU_RATES_SNAPSHOT_DIR=/var/lib/cu-rates/snapshots
# not yet read by the app (T055)
CU_RATES_DENYLIST_PATH=/var/lib/cu-rates/snapshots/denylist.json

# Live collection guard flag (MASTER.md D-15: must remain 0)
# not yet read by the app (T055)
CU_RATES_LIVE_COLLECTION_ENABLED=0
